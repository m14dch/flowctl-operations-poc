# Copy to .env and replace every value. Never commit .env.

# flowctl bootstrap admin (the only password login flowctl supports)
ADMIN_USERNAME=flowctl_admin
ADMIN_PASSWORD=change-me

# PostgreSQL
POSTGRES_USER=flowctl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flowctl

# Encryption key for flowctl secrets. Generate with: openssl rand -base64 32
KEYSTORE_KEEPER_URL=base64key://REPLACE_WITH_32_BYTE_BASE64_KEY

# Shared between Dex and flowctl
OIDC_CLIENT_SECRET=change-me

# Downstream technical credentials (alphanumeric). Also enter them as flowctl flow secrets.
SERVICE_A_USER=service-a-user
SERVICE_A_PASSWORD=change-me
SERVICE_B_USER=service-b-user
SERVICE_B_PASSWORD=change-me
